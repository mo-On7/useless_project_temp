{
    "manifest_version": 3,
    "name": "Universe Error Redirect",
    "version": "1.0",
    "description": "Redirects websites to a custom error page for two minutes.",
    "permissions": [
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Universe Error"
    }
}